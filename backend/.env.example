# Copy this file to .env and adjust values as needed.
# .env itself is gitignored - never commit real secrets.

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL here once you have it.
ALLOWED_ORIGINS=http://localhost:3000,https://shieldfeed.vercel.app

# Semantic Trigger Filter thresholds (cosine similarity, 0..1)
SEMANTIC_FILTER_THRESHOLD=0.5
SEMANTIC_WARN_THRESHOLD=0.3

# Pre-Post Toxicity Check threshold (probability, 0..1)
TOXICITY_WARN_THRESHOLD=0.5

# Pretrained model names (change only if you and the AI developer agree)
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TOXICITY_MODEL_NAME=martin-ha/toxic-comment-model
